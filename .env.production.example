# Copy to .env on your VPS and fill in real values
# DO NOT commit the real .env file to git

# Database
POSTGRES_USER=splitsmart
POSTGRES_PASSWORD=change-this-to-a-strong-random-password
POSTGRES_DB=splitsmart

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-64-char-random-string
JWT_EXPIRE_MINUTES=1440

# Set to false after first boot to prevent re-seeding demo data
SEED_DEMO=true

# Comma-separated list of allowed origins. Use your actual domain.
# Examples:
#   CORS_ORIGINS=https://splitsmart.example.com
#   CORS_ORIGINS=https://splitsmart.example.com,https://www.splitsmart.example.com
CORS_ORIGINS=https://your-domain.com

# What URL the frontend should call. With nginx reverse proxy on the same VPS,
# use your domain + /api. If frontend & backend are on different domains, set
# the full backend URL here.
NEXT_PUBLIC_API_URL=https://your-domain.com/api
